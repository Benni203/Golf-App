{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GolfApp: Flask Backend Debug (F5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "5001"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "GolfApp: Run All Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "tests"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

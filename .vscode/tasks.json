{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Sync Frontend (Cmd+Shift+B)",
      "type": "shell",
      "command": "python3 build_frontend.py",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m unittest discover tests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
